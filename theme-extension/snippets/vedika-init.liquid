{% comment %}
  Vedika Astrology — Initialization Snippet
  Include this once in theme.liquid or in each block that needs it.
  Injects the JS/CSS assets and points the widgets at the app proxy.

  Usage in theme.liquid:
    {% render 'vedika-init' %}

  No API key belongs here. Everything in this snippet is sent to every
  storefront visitor, so a key rendered into it could be read and billed by
  anyone. The widgets call /apps/vedika/... on the shop's own domain; Shopify
  forwards those calls to the app proxy server (app-proxy/ in this repo),
  which verifies Shopify's signature and adds the key server-side.
  An `api_key` render parameter from older themes is ignored (retired
  2026-09-17, Vastu review register leaks#3).

  (c) Vedika Intelligence — https://vedika.io
{% endcomment %}

{% unless vedika_initialized %}
  {% assign vedika_initialized = true %}

  {{ 'vedika-shopify.css' | asset_url | stylesheet_tag }}

  <script>
    window.VedikaConfig = {
      proxyBase: '/apps/vedika'
    };
  </script>

  {{ 'vedika-shopify.js' | asset_url | script_tag }}
{% endunless %}
